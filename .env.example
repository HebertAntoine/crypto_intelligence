# ============================================================
# CRYPTO INTELLIGENCE - configuration
# Copier vers .env :  cp .env.example .env
# NE JAMAIS committer .env
# ============================================================

# --- Mode ------------------------------------------------------------------
# true  = tout tourne sur fixtures/, sans reseau ni cle API
# false = providers reels
MOCK_MODE=false
LOG_LEVEL=INFO
ENV=local

# --- Base de donnees -------------------------------------------------------
# SQLite par defaut. Pour PostgreSQL :
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/crypto_intel
DATABASE_URL=sqlite:///data/crypto_intel.db

# --- API / frontend --------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8100
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# --- Scheduler -------------------------------------------------------------
# Le service durable exécute notamment le cycle macro à 00:00, 03:00, ... UTC.
# Mettre false uniquement pour une commande ponctuelle ou un worker séparé.
SCHEDULER_ENABLED=true

# ============================================================
# LLM - abstraction, changer de modele sans toucher au code
# ============================================================
# LLM_PROVIDER : anthropic | openai | ollama | mock | none
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=120

# Exemple Ollama local (aucune cle necessaire) :
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://localhost:11434

# ============================================================
# CLES GRATUITES - fortement recommandees
# ============================================================
# FRED (macro US : taux, CPI, PCE, emploi) - gratuit, immediat
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
FRED_CONTENT_USE_AUTHORIZED=false
FRED_THIRD_PARTY_REDISTRIBUTION_AUTHORIZED=false

# Indices/actions/FX. Une clé seule ne vaut pas droit de redistribution.
# N'activer le second drapeau qu'après validation du contrat/abonnement.
TWELVE_DATA_API_KEY=
TWELVE_DATA_REDISTRIBUTION_AUTHORIZED=false

# CoinGecko : désactivé par défaut. Le fait que l'API réponde ne confère pas
# de droit d'usage commercial ni de redistribution. Activer seulement après
# validation explicite du contrat applicable.
COINGECKO_API_KEY=
COINGECKO_COMMERCIAL_USE_AUTHORIZED=false
COINGECKO_ATTRIBUTION_CONFIGURED=false

# Congress.gov (suivi legislatif) - gratuit
# https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# Etherscan (gas, supply, burn ETH) - gratuit
# https://etherscan.io/apis
ETHERSCAN_API_KEY=

# La SEC exige un User-Agent nominatif pour ses flux (politique publique
# documentee de la SEC, ce n'est pas un contournement). Exemple de format :
# CryptoIntelligence/0.1 (your-real-email@domain.tld)
# Une valeur vide ou en example.com laisse les sources SEC désactivées.
SEC_USER_AGENT=

# ============================================================
# CLES PAYANTES - toutes optionnelles
# Sans elles : "UNAVAILABLE - provider not configured". Aucune valeur inventee.
# ============================================================
GLASSNODE_API_KEY=
CRYPTOQUANT_API_KEY=
NANSEN_API_KEY=
ARKHAM_API_KEY=
COINGLASS_API_KEY=
SOSOVALUE_API_KEY=
WHALE_ALERT_API_KEY=

# Adaptateur licencié uniquement : l'URL doit renvoyer une distribution
# FedWatch complète et horodatée. Aucun scraping de la page CME n'est tenté.
CME_FEDWATCH_API_URL=
CME_FEDWATCH_API_KEY=

# --- RPC optionnels --------------------------------------------------------
# RPC Solana public = rate limite. Un endpoint dedie est plus fiable.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ETH_RPC_URL=

# --- Reseau ----------------------------------------------------------------
HTTP_TIMEOUT=20
HTTP_USER_AGENT=CryptoIntelligence/0.1 (personal research tool)
CACHE_ENABLED=true
