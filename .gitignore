.env
.env.local
*.env
!.env.example
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Runtime state. All of it is regenerable from the CLI, and the database
# alone is ~40 MB - it belongs in a volume, not in version control.
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite3
data/cache/
data/exports/
data/datasets/
data/shadow/
# Selon le répertoire courant d'où la CLI est lancée, ces sorties atterrissent
# sous `data/` ou sous `backend/data/`. Les deux sont de l'état régénérable.
backend/data/
data/embeddings/
# The human-example dataset is yours, built by importing your own material.
# It is runtime state, not source.
data/trader_knowledge/
# Research outputs are regenerated by `make research`; the findings that
# matter are written up in docs/ instead.
data/research/*.json
data/research/*.csv
!data/research/.gitkeep
node_modules/
frontend/dist/
*.tsbuildinfo
.DS_Store
knowledge/**/*
!knowledge/**/.gitkeep
!knowledge/README.md
data/imports/etf/*.csv
!data/imports/etf/example.csv

# Frontend build output - produced by the Docker build or `npm run build`.
frontend/dist/

# Editor and OS noise
.idea/
.vscode/
*.swp

# Flutter app: build output and tool caches are regenerated by the build.
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.idea/
app/*.iml

# Refresh run logs are local runtime output, not source.
data/refresh_logs/

# Pipeline lock file, local runtime state.
data/.refresh.lock

# Per-source runtime state, rebuilt by the pipeline.
data/source_state.json

# Snapshot export works in a staging directory before swapping the set in.
# It is transient by construction and must never be committed.
app/assets/api_snapshots/.staging/

# Local database backups (hundreds of MB, never versioned).
data/backups/
